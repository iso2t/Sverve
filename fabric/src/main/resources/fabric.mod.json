{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "heavyinventories": [
      "com.iso2t.sverve.compat.heavyinventories.SverveWeightPlugin"
    ],
    "heavyinventories_client": [
      "com.iso2t.sverve.compat.heavyinventories.client.SverveWeightHudPlugin"
    ],
    "main": [
      "com.iso2t.sverve.SverveFabric"
    ],
    "client": [
      "com.iso2t.sverve.client.SverveFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "suggests": {
    "heavyinventories": ">=${heavyinventories_min_version}"
  },
  "breaks": {
    "heavyinventories": "<${heavyinventories_min_version}"
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "easyconfig": ">=${easyconfig_version}"
  }
}
