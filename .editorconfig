root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
ij_java_space_before_method_parentheses = true
ij_java_space_before_method_call_parentheses = false
ij_java_align_group_field_declarations = true
ij_java_blank_lines_after_class_header = 1
ij_java_blank_lines_around_method = 1

[*.gradle]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.bat]
end_of_line = crlf

[{*.json,*.mcmeta}]
indent_style = space
indent_size = 2
